<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Transfer"
        Height="780" Width="580"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResize"
        Background="#F9F9F9">

    <Window.Resources>
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
             <Setter Property="Height" Value="28"/>
             <Setter Property="VerticalContentAlignment" Value="Center"/>
             <Setter Property="Padding" Value="32,0,5,0"/>
             <Setter Property="BorderBrush" Value="#CE93D8"/>
             <Setter Property="FontSize" Value="12"/>
             <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Fill="#AA7B5C89" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                <TextBlock Text="{TemplateBinding Tag}" Foreground="#FFAAAAAA" VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False" FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" BorderThickness="0"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
             </Setter>
        </Style>

        <Style x:Key="AssignBtnStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>      
            <Setter Property="BorderBrush" Value="#CE93D8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="12"> 
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3E5F5"/>
                    <Setter Property="BorderBrush" Value="#AA7B5C89"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#CE93D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="14" FontWeight="Bold" Foreground="#FF7B5C89" Margin="5,0,0,5"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#F0F0F0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="1. Select Project &amp; Mode" Grid.Row="0">
            <StackPanel Margin="10">
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Source (From):" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="UI_CopyFrom" SelectionChanged="UIe_Project_Changed" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Target (To):" FontWeight="Bold" Foreground="#666" Margin="0,0,0,5"/>
                        <ComboBox x:Name="UI_CopyTo" SelectionChanged="UIe_Project_Changed" Height="30"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Transfer Mode:" Foreground="#666" Margin="0,0,0,5" FontWeight="Medium"/>
                <ComboBox x:Name="UI_Combo_TransferType" SelectionChanged="UIe_TransferType_Changed" Height="30"/>

                <TextBlock Text="* Note: Items existing in Target will be SKIPPED automatically." 
                           Foreground="#AA7B5C89" FontStyle="Italic" Margin="0,15,0,0" FontSize="11"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="2. Choose Elements" Grid.Row="1" x:Name="UI_GroupBox_List">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="UI_TextBox_Filter" Grid.Row="0" Tag="Filter elements..." Style="{StaticResource SearchTextBoxStyle}" TextChanged="UIe_text_filter_updated" Margin="0,0,0,10"/>

                <Border Grid.Row="1" BorderBrush="#EEE" BorderThickness="1" CornerRadius="4">
                    <ListView x:Name="UI_ListBox_Items" SelectionMode="Extended" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="380">
                                    <GridViewColumn.Header>
                                        <TextBlock Text="Name" FontWeight="Bold" Margin="5,0"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" 
                                                          Click="UIe_CheckBox_Clicked"
                                                          Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="Black"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                
                                <GridViewColumn Width="110">
                                    <GridViewColumn.HeaderContainerStyle>
                                        <Style TargetType="GridViewColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </GridViewColumn.HeaderContainerStyle>
                                    <GridViewColumn.Header>
                                        <TextBlock Text="Type" FontWeight="Bold"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Type}" Foreground="Black" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="btnCheckAll" Content="Select All" Style="{StaticResource AssignBtnStyle}" Width="80" Height="26" Click="UIe_btn_select_all" Margin="0,0,8,0"/>
                    <Button x:Name="btnCheckNone" Content="None" Style="{StaticResource AssignBtnStyle}" Width="80" Height="26" Click="UIe_btn_select_none"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="UI_btn_Run" Content="RUN TRANSFER" Style="{StaticResource AssignBtnStyle}" Width="120" Height="36" Click="UIe_btn_run" />
        </StackPanel>
    </Grid>
</Window>