<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shared Parameter Manager" Height="700" Width="1000" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResize" MinWidth="800" MinHeight="600">
    
    <Window.Resources>
        <Geometry x:Key="SearchIconGeometry">
            M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z
        </Geometry>

        <Style x:Key="SearchIconStyle" TargetType="Path">
            <Setter Property="Data" Value="{StaticResource SearchIconGeometry}"/>
            <Setter Property="Fill" Value="#AA7B5C89"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <VisualBrush x:Key="IconOnlyBrush" Stretch="None" AlignmentX="Left">
            <VisualBrush.Visual>
                <Path Style="{StaticResource SearchIconStyle}" Margin="5,0,0,0"/>
            </VisualBrush.Visual>
        </VisualBrush>

        <VisualBrush x:Key="IconAndTextBrush_Name" Stretch="None" AlignmentX="Left">
            <VisualBrush.Visual>
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource SearchIconStyle}" Margin="5,0,5,0"/>
                    <TextBlock Text="Search by Name..." Foreground="#AAA" FontStyle="Italic" VerticalAlignment="Center" FontWeight="Normal"/>
                </StackPanel>
            </VisualBrush.Visual>
        </VisualBrush>
        
        <VisualBrush x:Key="IconAndTextBrush_Group" Stretch="None" AlignmentX="Left">
            <VisualBrush.Visual>
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource SearchIconStyle}" Margin="5,0,5,0"/>
                    <TextBlock Text="Search by Group..." Foreground="#AAA" FontStyle="Italic" VerticalAlignment="Center" FontWeight="Normal"/>
                </StackPanel>
            </VisualBrush.Visual>
        </VisualBrush>
        
        <VisualBrush x:Key="IconAndTextBrush_Category" Stretch="None" AlignmentX="Left">
            <VisualBrush.Visual>
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource SearchIconStyle}" Margin="5,0,5,0"/>
                    <TextBlock Text="Search categories..." Foreground="#AAA" FontStyle="Italic" VerticalAlignment="Center" FontWeight="Normal"/>
                </StackPanel>
            </VisualBrush.Visual>
        </VisualBrush>

        <Style x:Key="SearchTextBoxStyle_Name" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="25,0,5,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource IconOnlyBrush}"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background" Value="{StaticResource IconAndTextBrush_Name}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchTextBoxStyle_Group" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="25,0,5,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource IconOnlyBrush}"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background" Value="{StaticResource IconAndTextBrush_Group}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchTextBoxStyle_Category" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="25,0,5,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource IconOnlyBrush}"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Background" Value="{StaticResource IconAndTextBrush_Category}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <SolidColorBrush x:Key="SelectionBackground" Color="#E1F5FE"/> 
        <SolidColorBrush x:Key="SelectionText" Color="Black"/>           

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E1F5FE"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E1F5FE"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5FDFF"/> 
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E1F5FE"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E1F5FE"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E1F5FE"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5FDFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E1F5FE"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#673AB7"/> 
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,0,0"/> 
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#673AB7"/> 
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="LightPurpleBtn" TargetType="Button">
            <Setter Property="Background" Value="#F3E5F5"/> 
            <Setter Property="Foreground" Value="#673AB7"/> 
            <Setter Property="BorderBrush" Value="#D1C4E9"/> 
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,4"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"> 
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AssignBtnStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="Black"/> <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1.5"
                                CornerRadius="12"> 
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LightGreenBtn" TargetType="Button" BasedOn="{StaticResource LightPurpleBtn}">
            <Setter Property="Background" Value="#D3F2E0"/> <Setter Property="BorderBrush" Value="#A5D6A7"/>
        </Style>

        <Style x:Key="PurpleHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F7F2F7"/> 
            <Setter Property="Foreground" Value="Black"/> 
            <Setter Property="FontWeight" Value="Bold"/> 
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#E1E1E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/> 
        </Style>
    </Window.Resources>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="*"/>    
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="Auto"/> 
        </Grid.RowDefinitions>

        <TextBlock Text="SHARED PARAMETER IMPORT MANAGER"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20" 
                   HorizontalAlignment="Center" Foreground="#673AB7"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/> 
                <ColumnDefinition Width="20"/> 
                <ColumnDefinition Width="1.2*"/> 
            </Grid.ColumnDefinitions>

            <GroupBox Header="1. Parameter List" Grid.Column="0" VerticalAlignment="Stretch">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="#CCC" BorderThickness="1" CornerRadius="3" Height="30" Margin="0,0,0,10" Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/> 
                                <ColumnDefinition Width="1"/>  
                                <ColumnDefinition Width="*"/>  
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="search_name_tb" Grid.Column="0" 
                                     Style="{StaticResource SearchTextBoxStyle_Name}"
                                     TextChanged="search_box_changed" FontWeight="Normal"/>

                            <Border Grid.Column="1" Background="#EEE" Margin="0,5"/>

                            <TextBox x:Name="search_group_tb" Grid.Column="2" 
                                     Style="{StaticResource SearchTextBoxStyle_Group}"
                                     TextChanged="search_box_changed" FontWeight="Normal"/>
                        </Grid>
                    </Border>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                        <Button x:Name="btn_check_all_param" Content="Check All" Style="{StaticResource LightGreenBtn}" Click="check_all_param_click" Margin="0,0,5,0"/>
                        <Button x:Name="btn_check_none_param" Content="None" Style="{StaticResource LightGreenBtn}" Click="check_none_param_click" Margin="0"/>
                    </StackPanel>

                    <DataGrid x:Name="result_dg" AutoGenerateColumns="False" 
                              CanUserAddRows="False" IsReadOnly="False" 
                              HeadersVisibility="Column" 
                              BorderBrush="#EEE" BorderThickness="1" SelectionMode="Extended"
                              FontWeight="Normal" 
                              GridLinesVisibility="Horizontal" 
                              RowBackground="White">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="30" CanUserResize="False" HeaderStyle="{StaticResource PurpleHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Click="param_checkbox_click"/> 
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="Parameter Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True"
                                                Foreground="Black"
                                                HeaderStyle="{StaticResource PurpleHeaderStyle}"/>
                            
                            <DataGridTextColumn Header="Type" Binding="{Binding ParamType}" Width="0.8*" IsReadOnly="True"
                                                Foreground="Black"
                                                HeaderStyle="{StaticResource PurpleHeaderStyle}"/>

                            <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="*" IsReadOnly="True"
                                                Foreground="Blue" FontWeight="Bold"
                                                HeaderStyle="{StaticResource PurpleHeaderStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> 
                    <RowDefinition Height="15"/>   
                    <RowDefinition Height="*"/>        
                </Grid.RowDefinitions>

                <GroupBox Header="2. Parameter Configuration" Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="Group Parameter Under:" Foreground="#D32F2F" Margin="0,5,0,2" FontWeight="SemiBold"/>
                        <ComboBox x:Name="group_cb" Height="30" VerticalContentAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="category_group_box" Header="3. Select Categories" Grid.Row="2" VerticalAlignment="Stretch">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="#CCC" BorderThickness="1" CornerRadius="3" Height="30" Margin="0,0,0,5" Background="White">
                            <TextBox x:Name="cat_search_tb" 
                                     Style="{StaticResource SearchTextBoxStyle_Category}"
                                     TextChanged="cat_search_changed" FontWeight="Normal"/>
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="btn_check_all" Content="Check All" Style="{StaticResource LightGreenBtn}"/>
                            <Button x:Name="btn_check_none" Content="None" Style="{StaticResource LightGreenBtn}"/>
                        </StackPanel>

                        <Border BorderBrush="#EEE" BorderThickness="1" Margin="0,5,0,0">
                            <ListBox x:Name="category_lb" ScrollViewer.VerticalScrollBarVisibility="Visible" FontWeight="Normal">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" 
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Margin="0,3"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Assign Parameter (Instance)" 
                    Style="{StaticResource AssignBtnStyle}"
                    Width="200" Height="35" 
                    Click="add_instance_click" 
                    Background="#E1F5FE" BorderBrush="#29B6F6"
                    Margin="0,0,20,0"/>
            
            <Button Content="Assign Parameter (Type)" 
                    Style="{StaticResource AssignBtnStyle}"
                    Width="200" Height="35" 
                    Click="add_type_click" 
                    Background="#FFF3E0" BorderBrush="#FFA726"/>
        </StackPanel>

        <StatusBar Grid.Row="3" Margin="0,5,0,0">
            <TextBlock x:Name="status_lb" Text="Ready." Foreground="Gray" FontStyle="Italic"/>
        </StatusBar>
    </Grid>
</Window>