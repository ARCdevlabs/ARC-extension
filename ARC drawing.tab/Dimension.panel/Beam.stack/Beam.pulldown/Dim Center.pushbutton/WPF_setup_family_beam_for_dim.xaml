				        Height="25"
				        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Foreground="Black" 
                        Background="White" 
                        Focusable="True"   
                        />
                    </Grid>
                </Grid>
            </StackPanel>

