                        Header="Guide"
                        Background="WhiteSmoke"
                        Height="620" BorderBrush="Black"
                        >
                <StackPanel x:Name="GroupBoxContent" 
                        Orientation="Vertical">
                    <Label Content="Setting Reference Name, Fukashi Parameter of Beam." />
                    <Image x:Name="guide_image_1"
                           Width="405" 
                           Height="359" 
                           Stretch="Uniform" />
                    <Label Content="Setting the dimension in need." />
                    <Image x:Name="guide_image_2"
                           Width="405" 
                           Height="169" 
                           Stretch="Uniform" />
                </StackPanel>
            </GroupBox>
        </StackPanel>

