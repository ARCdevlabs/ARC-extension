<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Splasher 2026 - Code by Tung"
        Height="800" Width="1100"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
             <Setter Property="Height" Value="24"/>
             <Setter Property="VerticalContentAlignment" Value="Center"/>
             <Setter Property="Padding" Value="24,0,5,0"/>
             <Setter Property="BorderBrush" Value="#CE93D8"/>
             <Setter Property="FontSize" Value="12"/>
             <Setter Property="FontWeight" Value="Normal"/>
             <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                            <Grid>
                                <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Fill="#AA7B5C89"
                                      Stretch="Uniform"
                                      Width="12" Height="12"
                                      HorizontalAlignment="Left"
                                      Margin="6,0,0,0"/>
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Foreground="#FFAAAAAA"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Margin="24,0,0,0"
                                           IsHitTestVisible="False"
                                           FontStyle="Italic">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer x:Name="PART_ContentHost" BorderThickness="0"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AssignBtnStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>      
            <Setter Property="BorderBrush" Value="#CE93D8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1.5"
                                CornerRadius="12"> 
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3E5F5"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#CE93D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#FF7B5C89"
                                   Margin="5,0,0,5"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <GroupBox Header="1. Select Category" Grid.Row="0" Grid.Column="0">
            <ListBox x:Name="lbCategories"
                     SelectionMode="Extended"
                     DisplayMemberPath="Name"
                     SelectionChanged="lbCategories_SelectionChanged"/>
        </GroupBox>
        
        <GroupBox Header="2. Select Parameter" Grid.Row="2" Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBox x:Name="txtSearchParam"
                         Grid.Row="0"
                         Tag="Search Parameter..."
                         Style="{StaticResource SearchTextBoxStyle}"
                         TextChanged="txtSearchParam_TextChanged"
                         Margin="0,0,0,5"/>

                <ListBox x:Name="lbParameters"
                         Grid.Row="1"
                         SelectionMode="Single"
                         SelectionChanged="lbParameters_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Name}" Foreground="Black"/>
                                <Run Text=" "/>
                                <Run Text="{Binding TypeLabel}" FontWeight="Bold" Foreground="Red"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>
        
        <GroupBox Header="3. Values &amp; Select" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    </Grid.RowDefinitions>
                
                <DockPanel Grid.Row="0" Margin="0,0,0,5" LastChildFill="False">
                    <Button x:Name="btnCheckAll" 
                            Content="Check All" 
                            Style="{StaticResource AssignBtnStyle}" 
                            FontSize="11" 
                            Width="57" Height="22" 
                            Margin="0,0,5,0" 
                            Click="btnCheckAll_Click"/>
                    
                    <Button x:Name="btnCheckNone" 
                            Content="None" 
                            Style="{StaticResource AssignBtnStyle}" 
                            FontSize="11"
                            Width="57" Height="22" 
                            Click="btnCheckNone_Click"/>
                </DockPanel>

                <ListView x:Name="lvValues" 
                          Grid.Row="1" 
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                          SizeChanged="lvValues_SizeChanged"
                          MouseDoubleClick="lvValues_MouseDoubleClick">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn>
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="4,2"/> 
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>

                                <GridViewColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Value" FontWeight="Normal" HorizontalAlignment="Left" Margin="2,0,0,4"/>
                                            <TextBox x:Name="txtSearchValue"
                                                     Grid.Row="1"
                                                     Tag="Search Value..."
                                                     Style="{StaticResource SearchTextBoxStyle}"
                                                     TextChanged="txtSearchValue_TextChanged"
                                                     HorizontalAlignment="Stretch"/> 
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.HeaderTemplate>
                                
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding BackgroundBrush}" Padding="6,2" Margin="-6,0">
                                            <DockPanel LastChildFill="True">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" Foreground="Black" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            
                            <GridViewColumn Width="70">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="4,2"/> 
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                
                                <GridViewColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Count" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtTotalCount"
                                                     Grid.Row="1"
                                                     Text="0"
                                                     IsReadOnly="True"
                                                     HorizontalAlignment="Stretch"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     BorderBrush="#CE93D8"
                                                     BorderThickness="1"
                                                     Height="24"
                                                     Background="#F5F5F5"
                                                     FontWeight="Bold"
                                                     Foreground="#FF7B5C89"
                                                     Loaded="txtTotalCount_Loaded"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.HeaderTemplate>

                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding BackgroundBrush}" Padding="6,2" Margin="-6,0">
                                            <TextBlock Text="{Binding Count, StringFormat='({0})'}" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" MinHeight="20"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </GroupBox>
        
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnRainbow" Style="{StaticResource AssignBtnStyle}" Content="Rainbow" Width="100" Height="30" Margin="5" Click="btnRainbow_Click"/>
            <Button x:Name="btnRefresh" Style="{StaticResource AssignBtnStyle}" Content="Refresh" Width="100" Height="30" Margin="5" Click="btnRefresh_Click"/>
            <Button x:Name="btnApply" Style="{StaticResource AssignBtnStyle}" Content="Apply Color" Width="100" Height="30" Margin="5" Click="btnApply_Click"/>
            <Button x:Name="btnClear" Style="{StaticResource AssignBtnStyle}" Content="Clear Color" Width="100" Height="30" Margin="5" Click="btnClear_Click"/>
            <Button x:Name="btnSelect" Style="{StaticResource AssignBtnStyle}" Content="Select" Width="100" Height="30" Margin="5" Click="btnSelect_Click"/>
        </StackPanel>
    </Grid>
</Window>