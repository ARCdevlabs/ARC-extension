<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a Color"
        Height="500" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Select a color for the item:" 
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10"
                   Foreground="#FF7B5C89"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="wpColors" ItemWidth="25" ItemHeight="25" Orientation="Horizontal"/>
        </ScrollViewer>

        <Button x:Name="btnCancel" Grid.Row="2" 
                Content="Cancel" 
                Width="100" Height="30" 
                HorizontalAlignment="Right" Margin="0,10,0,0"
                Click="btnCancel_Click"/>
    </Grid>
</Window>